rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Signed-in users can read all collections (chargers, public profiles, bookings, sessions)
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Users can write only their own user document
    match /users/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Chargers can only be created/updated by their owner
    match /chargers/{chargerId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Bookings are writable by the driver or the owner involved
    match /bookings/{bookingId} {
      allow create: if request.auth != null && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.driverId == request.auth.uid || resource.data.ownerId == request.auth.uid
      );
    }

    // Sessions are writable by driver or owner involved
    match /sessions/{sessionId} {
      allow create: if request.auth != null && (
        request.resource.data.driverId == request.auth.uid || request.resource.data.ownerId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.driverId == request.auth.uid || resource.data.ownerId == request.auth.uid
      );
    }

    // Wallets: users read/write their own wallet. Payment batches can update owner wallets and create transactions.
    match /wallets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;

      match /transactions/{txId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }
    }
  }
}
